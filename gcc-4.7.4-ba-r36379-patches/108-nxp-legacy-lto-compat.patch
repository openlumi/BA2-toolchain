+/* Read a legacy 32-bit unsigned word encoded as ULEB128.  Reject values
+   wider than 32 bits or encodings longer than five bytes before an invalid
+   shift or narrowing.  This is not a general LTO format detector.  */
+
+uint32_t
+streamer_read_uhwi32 (struct lto_input_block *ib)
+{
+  uint32_t result = 0;
+  unsigned shift;
+
+  for (shift = 0; shift <= 28; shift += 7)
+    {
+      unsigned byte = streamer_read_uchar (ib);
+      if (shift == 28 && (byte & 0xf0))
+        fatal_error ("invalid 32-bit NXP LTO word; rebuild objects with "
+                     "the NXP-compatible toolchain");
+      result |= (uint32_t) (byte & 0x7f) << shift;
+      if (!(byte & 0x80))
+        return result;
+    }
+  gcc_unreachable ();
+}
+
+/* Some legacy fields are signed, but were written with the unsigned
+   encoder.  Extend their 32-bit two's-complement representation explicitly,
+   rather than interpreting 0xfffffffc as +4294967292 on LP64.  */
+
+HOST_WIDE_INT
+streamer_read_hwi32 (struct lto_input_block *ib)
+{
+  uint32_t word = streamer_read_uhwi32 (ib);
+  if (word & 0x80000000U)
+    return -1 - (HOST_WIDE_INT) (0xffffffffU - word);
+  return word;
+}
